# Comma-separated list of symbols to trade
SYMBOLS=BTCUSDT,ETHUSDT

# Take profit % from entry
TP_PCT=1.5

# Stop loss % from entry
SL_PCT=0.8

# Minimum confidence score (0-100) to open a trade
MIN_CONFIDENCE=45

# Paper position size in USD
POSITION_SIZE_USD=100

# How often to run strategy cycle (minutes)
SIGNAL_INTERVAL=5

# SQLite DB path (Railway will use ephemeral storage — use a volume or external DB for persistence)
DB_PATH=trading.db
